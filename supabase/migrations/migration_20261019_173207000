create table if not exists public.tributacoes (
  id uuid primary key default gen_random_uuid(),
  nome text not null,
  ordem integer not null default 100,
  created_at timestamptz not null default now()
);

create unique index if not exists tributacoes_nome_key on public.tributacoes (lower(nome));

alter table public.tributacoes enable row level security;

create policy tributacoes_read on public.tributacoes
  for select to authenticated using (true);

create policy tributacoes_admin_all on public.tributacoes
  for all to authenticated using (is_admin()) with check (is_admin());

