-- Anotações (notas estilo Excel) das células de Empresas com funcionários
create table if not exists public.empresas_funcionarios_comentarios (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  mes_referencia text not null,
  campo text not null,
  comentario text not null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint empresas_funcionarios_comentarios_key unique (company_id, mes_referencia, campo)
);

alter table public.empresas_funcionarios_comentarios enable row level security;

create policy empresas_funcionarios_comentarios_admin_all on public.empresas_funcionarios_comentarios
  for all to public using (is_admin()) with check (is_admin());

create policy empresas_funcionarios_comentarios_member_all on public.empresas_funcionarios_comentarios
  for all to public
  using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    join public.departments d on d.id = cd.department_id
    where cd.company_id = empresas_funcionarios_comentarios.company_id
      and pd.profile_id = auth.uid()
      and d.name = 'Depart. Pessoal'
  ))
  with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    join public.departments d on d.id = cd.department_id
    where cd.company_id = empresas_funcionarios_comentarios.company_id
      and pd.profile_id = auth.uid()
      and d.name = 'Depart. Pessoal'
  ));

grant select, insert, update, delete on public.empresas_funcionarios_comentarios to anon, authenticated;