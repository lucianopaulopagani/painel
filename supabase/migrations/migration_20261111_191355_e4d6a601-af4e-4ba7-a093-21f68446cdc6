-- Módulo Emissor NFS-e (painel + configuração do certificado)
create table if not exists public.nfse_configuracoes (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null unique references public.companies(id) on delete cascade,
  ambiente text not null default 'restrita' check (ambiente in ('restrita', 'producao')),
  certificado_path text,
  certificado_nome text,
  certificado_validade date,
  certificado_titular text,
  inscricao_municipal text,
  codigo_municipio text,
  codigo_servico text,
  nbs text,
  aliquota_iss numeric(6,4) not null default 0,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

alter table public.nfse_configuracoes enable row level security;
create policy nfse_configuracoes_read on public.nfse_configuracoes
  for select using (auth.uid() is not null);

create table if not exists public.nfse_notas (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  numero text,
  chave text,
  status text not null default 'pendente',
  tomador_nome text,
  tomador_documento text,
  valor numeric(14,2),
  competencia date,
  xml_path text,
  mensagem text,
  created_at timestamptz not null default now()
);

create index if not exists nfse_notas_company_idx
  on public.nfse_notas (company_id, competencia desc);

alter table public.nfse_notas enable row level security;
create policy nfse_notas_read on public.nfse_notas
  for select using (auth.uid() is not null);

