create table if not exists public.profile_submenus (
  profile_id uuid not null references public.profiles(id) on delete cascade,
  submenu_id uuid not null references public.department_submenus(id) on delete cascade,
  created_at timestamptz not null default now(),
  primary key (profile_id, submenu_id)
);

alter table public.profile_submenus enable row level security;

create policy "profile_submenus_admin_all" on public.profile_submenus
  for all using (public.is_admin()) with check (public.is_admin());

create policy "profile_submenus_read_own" on public.profile_submenus
  for select using (profile_id = auth.uid());