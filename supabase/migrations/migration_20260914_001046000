create table if not exists public.ponto (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  mes_referencia text not null,
  envio text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (company_id, mes_referencia)
);

alter table public.ponto enable row level security;

create policy "ponto_admin_all" on public.ponto
  for all using (public.is_admin()) with check (public.is_admin());

create policy "ponto_member_all" on public.ponto
  for all
  using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = ponto.company_id and pd.profile_id = auth.uid()))
  with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = ponto.company_id and pd.profile_id = auth.uid()));