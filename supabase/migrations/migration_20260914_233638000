create table if not exists public.balancete_balanco (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  ano text not null,
  jan text,
  fev text,
  mar text,
  abr text,
  mai text,
  jun text,
  jul text,
  ago text,
  set text,
  out text,
  nov text,
  dez text,
  fechamento text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (company_id, ano)
);

alter table public.balancete_balanco enable row level security;

create policy "balancete_balanco_admin_all" on public.balancete_balanco
  for all using (public.is_admin()) with check (public.is_admin());

create policy "balancete_balanco_member_all" on public.balancete_balanco
  for all
  using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = balancete_balanco.company_id and pd.profile_id = auth.uid()))
  with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = balancete_balanco.company_id and pd.profile_id = auth.uid()));