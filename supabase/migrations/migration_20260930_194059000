create table if not exists public.balancete_comentarios (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  ano text not null,
  campo text not null,
  comentario text not null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (company_id, ano, campo)
);

alter table public.balancete_comentarios enable row level security;

create policy "balancete_comentarios_admin_all" on public.balancete_comentarios
  for all using (public.is_admin()) with check (public.is_admin());

create policy "balancete_comentarios_member_all" on public.balancete_comentarios
  for all
  using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = balancete_comentarios.company_id and pd.profile_id = auth.uid()))
  with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = balancete_comentarios.company_id and pd.profile_id = auth.uid()));