-- Paleta de cores do Cadastro de Tabelas: três tons usados pelas tabelas atuais
alter table public.cadastro_opcoes drop constraint cadastro_opcoes_cor_check;
alter table public.cadastro_opcoes
  add constraint cadastro_opcoes_cor_check
  check (cor in ('success','info','warning','danger','neutral','disabled','primary','dark','silver'));

-- Departamento Pessoal: status das tabelas mensais
insert into public.cadastro_opcoes (departamento, tabela, campo, nome, cor, ordem)
select c.departamento, c.tabela, c.campo, o.nome, o.cor, o.ordem
from (values
  ('Depart. Pessoal','Empresas com funcionários','status'),
  ('Depart. Pessoal','Empresas Fiscal','status')
) as c(departamento, tabela, campo)
cross join (values
  ('Concluído','success',1),
  ('Pendente','danger',2),
  ('Em Andamento','warning',3),
  ('Em Ajuste','primary',4)
) as o(nome, cor, ordem)
on conflict do nothing;

