create or replace function public.dashboard_fiscal(mes text)
returns table (
  company_id uuid,
  numero text,
  name text,
  uf text,
  situacao text
)
language sql
security definer
set search_path = public
as $$
  select c.id, c.numero, c.name, c.uf, mf.situacao
  from public.companies c
  join public.company_departments cd on cd.company_id = c.id
  join public.departments d on d.id = cd.department_id
  left join public.movimento_fiscal mf
    on mf.company_id = c.id and mf.mes_referencia = mes
  where d.name = 'Depart. Fiscal'
  order by c.numero;
$$;

revoke execute on function public.dashboard_fiscal(text) from anon;
grant execute on function public.dashboard_fiscal(text) to authenticated;