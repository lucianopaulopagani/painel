-- Controle de Parcelamentos (Depart. Fiscal): registro mensal por empresa
create table if not exists public.parcelamentos (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  mes_referencia text not null,
  simples text,
  mei_relp_iss text,
  estadual text,
  inss_rfb text,
  inss_pgfn text,
  sn_pgfn text,
  pert text,
  sn_relp text,
  relp_pgfn text,
  municipal text,
  envio text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint parcelamentos_company_mes_key unique (company_id, mes_referencia)
);

create table if not exists public.parcelamentos_comentarios (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  mes_referencia text not null,
  campo text not null,
  comentario text not null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint parcelamentos_comentarios_company_mes_campo_key unique (company_id, mes_referencia, campo)
);

alter table public.parcelamentos enable row level security;
alter table public.parcelamentos_comentarios enable row level security;

create policy parcelamentos_admin_all on public.parcelamentos
  for all to public using (is_admin()) with check (is_admin());

create policy parcelamentos_member_all on public.parcelamentos
  for all to public
  using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    join public.departments d on d.id = cd.department_id
    where cd.company_id = parcelamentos.company_id
      and pd.profile_id = auth.uid()
      and d.name = 'Depart. Fiscal'
  ))
  with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    join public.departments d on d.id = cd.department_id
    where cd.company_id = parcelamentos.company_id
      and pd.profile_id = auth.uid()
      and d.name = 'Depart. Fiscal'
  ));

create policy parcelamentos_comentarios_admin_all on public.parcelamentos_comentarios
  for all to public using (is_admin()) with check (is_admin());

create policy parcelamentos_comentarios_member_all on public.parcelamentos_comentarios
  for all to public
  using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    join public.departments d on d.id = cd.department_id
    where cd.company_id = parcelamentos_comentarios.company_id
      and pd.profile_id = auth.uid()
      and d.name = 'Depart. Fiscal'
  ))
  with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    join public.departments d on d.id = cd.department_id
    where cd.company_id = parcelamentos_comentarios.company_id
      and pd.profile_id = auth.uid()
      and d.name = 'Depart. Fiscal'
  ));

grant select, insert, update, delete on public.parcelamentos to anon, authenticated;
grant select, insert, update, delete on public.parcelamentos_comentarios to anon, authenticated;