create table if not exists public.fiscal_colunas (
  campo text primary key,
  label text not null,
  updated_at timestamptz not null default now()
);

comment on table public.fiscal_colunas is 'Nome exibido no cabeçalho de cada coluna do Movimento Fiscal (vale para todas as tabelas do departamento Fiscal).';

alter table public.fiscal_colunas enable row level security;

create policy fiscal_colunas_read on public.fiscal_colunas
  for select to authenticated using (true);

create policy fiscal_colunas_admin_all on public.fiscal_colunas
  for all to authenticated using (is_admin()) with check (is_admin());

