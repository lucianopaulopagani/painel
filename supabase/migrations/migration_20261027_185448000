-- Data Base: meses em 3 letras (Empresas com funcionários)
insert into public.cadastro_opcoes (departamento, tabela, campo, nome, cor, ordem)
select 'Depart. Pessoal', 'Empresas com funcionários', 'dataBase', m.nome, 'neutral', m.ordem
from (values
  ('JAN',1),('FEV',2),('MAR',3),('ABR',4),('MAI',5),('JUN',6),
  ('JUL',7),('AGO',8),('SET',9),('OUT',10),('NOV',11),('DEZ',12)
) as m(nome, ordem)
on conflict do nothing;

