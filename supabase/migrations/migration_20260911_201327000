drop policy if exists "movimento_fiscal_member_read" on public.movimento_fiscal;
drop policy if exists "movimento_fiscal_member_insert" on public.movimento_fiscal;
drop policy if exists "movimento_fiscal_member_update" on public.movimento_fiscal;
drop policy if exists "movimento_fiscal_member_delete" on public.movimento_fiscal;

create policy "movimento_fiscal_member_read" on public.movimento_fiscal
  for select using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = movimento_fiscal.company_id
      and pd.profile_id = auth.uid()
      and auth.uid() = any(cd.responsible_profile_ids)));

create policy "movimento_fiscal_member_insert" on public.movimento_fiscal
  for insert with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = movimento_fiscal.company_id
      and pd.profile_id = auth.uid()
      and auth.uid() = any(cd.responsible_profile_ids))
    and (
      movimento_fiscal.mes_referencia <= to_char(current_date - interval '1 month', 'YYYY-MM')
      or (
        movimento_fiscal.mes_referencia = to_char(current_date, 'YYYY-MM')
        and public.month_is_released(movimento_fiscal.mes_referencia)
      )
    ));

