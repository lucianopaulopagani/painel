create table if not exists public.alvara_sanitario (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  ano text not null,
  vencimento text,
  gerado text,
  enviado text,
  observacao text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (company_id, ano)
);

alter table public.alvara_sanitario enable row level security;

create policy "alvara_sanitario_admin_all" on public.alvara_sanitario
  for all using (public.is_admin()) with check (public.is_admin());

create policy "alvara_sanitario_member_all" on public.alvara_sanitario
  for all
  using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = alvara_sanitario.company_id and pd.profile_id = auth.uid()))
  with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = alvara_sanitario.company_id and pd.profile_id = auth.uid()));

insert into public.department_submenus (department_id, name, position)
select d.id, 'Alvará Sanitário',
  coalesce((select max(ds.position) + 1 from public.department_submenus ds where ds.department_id = d.id), 0)
from public.departments d
where d.name = 'Societário'
on conflict (department_id, name) do nothing;