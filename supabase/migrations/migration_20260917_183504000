alter table public.profiles
  add column if not exists avatar_url text;

create or replace function public.update_own_profile(full_name text, avatar_url text)
returns boolean
language sql
security definer
set search_path = public
as $$
  update public.profiles
  set
    full_name = coalesce(update_own_profile.full_name, full_name),
    avatar_url = coalesce(update_own_profile.avatar_url, avatar_url)
  where id = auth.uid()
  returning true;
$$;

grant execute on function public.update_own_profile(text, text) to authenticated;
revoke execute on function public.update_own_profile(text, text) from anon;