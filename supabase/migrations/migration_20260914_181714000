create table if not exists public.complemento_inss (
  id uuid primary key default gen_random_uuid(),
  company_id uuid not null references public.companies(id) on delete cascade,
  mes_referencia text not null,
  darf text,
  envio text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (company_id, mes_referencia)
);

alter table public.complemento_inss enable row level security;

create policy "complemento_inss_admin_all" on public.complemento_inss
  for all using (public.is_admin()) with check (public.is_admin());

create policy "complemento_inss_member_all" on public.complemento_inss
  for all
  using (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = complemento_inss.company_id and pd.profile_id = auth.uid()))
  with check (exists (
    select 1 from public.company_departments cd
    join public.profile_departments pd on pd.department_id = cd.department_id
    where cd.company_id = complemento_inss.company_id and pd.profile_id = auth.uid()));