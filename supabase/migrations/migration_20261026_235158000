alter table public.tributacao_status
  add column if not exists campo text not null default 'situacao';

comment on column public.tributacao_status.campo is 'Coluna de menu suspenso da tabela do Movimento Fiscal: situacao, das, guia, destda, envio_sn, envio_icms, prestados, tomados, iss_fixo, carne_leao, envio_guia e as obrigações do Lucro Real/Presumido.';

drop index if exists public.tributacao_status_key;
create unique index if not exists tributacao_status_key
  on public.tributacao_status (tributacao_id, campo, lower(nome));

create index if not exists tributacao_status_campo_idx
  on public.tributacao_status (tributacao_id, campo);

insert into public.tributacao_status (tributacao_id, campo, nome, cor, ordem)
select t.id, f.campo, o.nome, o.cor, o.ordem
from public.tributacoes t
join (values
  ('Simples Nacional', 'das'),
  ('Simples Nacional', 'guia'),
  ('Simples Nacional', 'destda'),
  ('Simples Nacional', 'envio_sn'),
  ('Simples Nacional', 'envio_icms'),
  ('MEI', 'das'),
  ('MEI', 'envio_sn'),
  ('Carne Leão', 'iss_fixo'),
  ('Carne Leão', 'carne_leao'),
  ('Carne Leão', 'envio_guia')
) as f(tributacao, campo) on f.tributacao = t.nome
cross join (values
  ('OK', 'success', 1),
  ('OK-SM', 'info', 2)
) as o(nome, cor, ordem)
on conflict (tributacao_id, campo, lower(nome)) do nothing;

insert into public.tributacao_status (tributacao_id, campo, nome, cor, ordem)
