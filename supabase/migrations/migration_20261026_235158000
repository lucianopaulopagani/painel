insert into public.tributacao_status (tributacao_id, campo, nome, cor, ordem)
select t.id, f.campo, o.nome, o.cor, o.ordem
from public.tributacoes t
join (values ('Lucro Real'), ('Lucro Presumido')) as l(tributacao) on l.tributacao = t.nome
cross join (values
  ('issqn'), ('dime_gia_pr'), ('dapi'), ('gia_rs'), ('drcst'),
  ('sped_fiscal'), ('sped_contr'), ('reinf'), ('dirbi'), ('mit')
) as f(campo)
cross join (values
  ('OK', 'success', 1),
  ('SM', 'info', 2),
  ('X', 'warning', 3),
  ('Dispensada', 'neutral', 4),
  ('Pendências', 'danger', 5),
  ('Desabilitado', 'disabled', 6)
) as o(nome, cor, ordem)
on conflict (tributacao_id, campo, lower(nome)) do nothing;